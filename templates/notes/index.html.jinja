{% extends "_layout.html" %}
{% set metatitle = "Notes" %}
{% set metadescription = "Notes by Nicolas Bouliane" %}
{% set canonicalUrl = "/blog" %}

{% block content %}
    <header>
        <h1>Notes</h1>
        <small>Digital clippings I might Whatsapp you.</small>
    </header>
    <ul class="entry-list notes">
        {% for entry in get_entries('notes', sort_by='date_created', reverse=True) %}
            <li>
                <a class="date" href="{{ entry.url }}" rel="bookmark">
                    <time datetime="{{ entry.date_created.strftime('%F') }}">{{ entry.date_created.strftime('%d.%m') }}<br>{{ entry.date_created.strftime('%Y') }}</time>
                </a>
                <div>
                    {{ entry.body|render|safe }}
                </div>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
