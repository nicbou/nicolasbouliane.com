{% extends "_layout.html" %}
{% set metatitle = "Note" %}
{% set metadescription = "Note" %}
{% set canonicalUrl = entry.url %}

{% block postHead %}
    <link rel="index" href="{{ site_url }}/notes">
{% endblock %}

{% block content %}
    <article>
        <p><a href="{{ site_url }}/notes">Notes</a> <span class="arrow">➤</span> <time datetime="{{ entry.date_created.strftime('%F') }}">{{ entry.date_created.strftime('%B %-d, %Y') }}</time></p>
        {{ entry.body|render|safe }}
        <footer>
            <p>Reply by email: <a href="mailto:contact@nicolasbouliane.com">contact@nicolasbouliane.com</a>.</p>
        </footer>
    </article>
{% endblock %}
